{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "version": "2.0.0",
    "system": "Cognitive Scaffold Design System",
    "colorSpace": "OKLCH",
    "generatedAt": "2026-07-31",
    "description": "Machine-legible W3C DTCG token manifest. Primitives: OKLCH raw values. Semantics: aliases. Agentic: enterprise AI-pattern tokens."
  },
  "primitive": {
    "neutral": {
      "0":   { "$value": "oklch(0% 0 0)",       "$type": "color" },
      "50":  { "$value": "oklch(6.7% 0 0)",     "$type": "color", "$description": "#0D0D0D" },
      "100": { "$value": "oklch(10% 0 0)",      "$type": "color", "$description": "#161616" },
      "150": { "$value": "oklch(13% 0 0)",      "$type": "color", "$description": "#1C1C1C" },
      "200": { "$value": "oklch(20% 0 0)",      "$type": "color", "$description": "#2A2A2A" },
      "400": { "$value": "oklch(49% 0.004 60)", "$type": "color" },
      "900": { "$value": "oklch(93% 0.007 75)", "$type": "color", "$description": "#F0EDE8" },
      "950": { "$value": "oklch(100% 0 0)",     "$type": "color" }
    },
    "amber": {
      "400": { "$value": "oklch(74% 0.12 60)",  "$type": "color" },
      "500": { "$value": "oklch(67% 0.099 55)", "$type": "color", "$description": "#C8975A primary brand" },
      "600": { "$value": "oklch(57% 0.09 55)",  "$type": "color" },
      "700": { "$value": "oklch(51% 0.006 60)", "$type": "color" }
    },
    "green": {
      "500": { "$value": "oklch(65% 0.15 145)", "$type": "color" },
      "600": { "$value": "oklch(55% 0.14 145)", "$type": "color" }
    },
    "red": {
      "500": { "$value": "oklch(62% 0.2 25)",  "$type": "color" },
      "600": { "$value": "oklch(52% 0.18 25)", "$type": "color" }
    },
    "blue": {
      "400": { "$value": "oklch(70% 0.14 255)", "$type": "color" },
      "500": { "$value": "oklch(60% 0.16 255)", "$type": "color" }
    }
  },
  "semantic": {
    "bg":             { "$value": "{primitive.neutral.50}",  "$type": "color" },
    "surface":        { "$value": "{primitive.neutral.150}", "$type": "color" },
    "surface-subtle": { "$value": "{primitive.neutral.100}", "$type": "color" },
    "border":         { "$value": "{primitive.neutral.200}", "$type": "color" },
    "text":           { "$value": "{primitive.neutral.900}", "$type": "color" },
    "text-muted":     { "$value": "{primitive.neutral.400}", "$type": "color" },
    "brand":          { "$value": "{primitive.amber.500}",   "$type": "color" },
    "brand-fg":       { "$value": "{primitive.neutral.50}",  "$type": "color" }
  },
  "agentic": {
    "urgency": {
      "high":   { "$value": "{primitive.amber.500}", "$type": "color", "$description": "Immediate action required" },
      "medium": { "$value": "{primitive.amber.600}", "$type": "color", "$description": "Review soon" },
      "low":    { "$value": "{primitive.amber.700}", "$type": "color", "$description": "Standard queue" }
    },
    "hitl": {
      "approve":    { "$value": "{primitive.green.500}",   "$type": "color" },
      "approve-fg": { "$value": "{primitive.neutral.0}",   "$type": "color" },
      "reject":     { "$value": "{primitive.red.500}",     "$type": "color" },
      "reject-fg":  { "$value": "{primitive.neutral.950}", "$type": "color" },
      "stage":      { "$value": "{primitive.blue.400}",    "$type": "color" },
      "stage-fg":   { "$value": "{primitive.neutral.0}",   "$type": "color" }
    },
    "chainOfThought": {
      "step":    { "$value": "{primitive.amber.500}",   "$type": "color" },
      "surface": { "$value": "{primitive.neutral.150}", "$type": "color" },
      "border":  { "$value": "{primitive.neutral.200}", "$type": "color" }
    },
    "ruleOfThree": {
      "primary":   { "$value": "{primitive.amber.500}", "$type": "color", "$description": "Highest-priority intervention" },
      "secondary": { "$value": "{primitive.amber.600}", "$type": "color" },
      "tertiary":  { "$value": "{primitive.amber.700}", "$type": "color" }
    }
  },
  "typography": {
    "font-sans": { "$value": "'Inter', system-ui, sans-serif",               "$type": "fontFamily" },
    "font-mono": { "$value": "'SFMono-Regular', Consolas, Menlo, monospace", "$type": "fontFamily" },
    "scale": {
      "9":  { "$value": "0.5625rem", "$type": "dimension" },
      "10": { "$value": "0.625rem",  "$type": "dimension" },
      "11": { "$value": "0.6875rem", "$type": "dimension" },
      "12": { "$value": "0.75rem",   "$type": "dimension" },
      "13": { "$value": "0.8125rem", "$type": "dimension" },
      "14": { "$value": "0.875rem",  "$type": "dimension" },
      "16": { "$value": "1rem",      "$type": "dimension" },
      "18": { "$value": "1.125rem",  "$type": "dimension" }
    }
  },
  "motion": {
    "duration": {
      "instant":  { "$value": "100ms",  "$type": "duration" },
      "fast":     { "$value": "200ms",  "$type": "duration" },
      "default":  { "$value": "300ms",  "$type": "duration" },
      "slow":     { "$value": "500ms",  "$type": "duration" },
      "approval": { "$value": "1100ms", "$type": "duration", "$description": "HITL staged approval total" }
    },
    "easing": {
      "default": { "$value": "cubic-bezier(0.4,0,0.2,1)",      "$type": "cubicBezier" },
      "spring":  { "$value": "cubic-bezier(0.34,1.56,0.64,1)", "$type": "cubicBezier" },
      "out":     { "$value": "cubic-bezier(0,0,0.2,1)",         "$type": "cubicBezier" }
    }
  },
  "pattern": {
    "chainOfThoughtDrawer": {
      "$description": "Collapsible AI reasoning audit drawer — purely presentational",
      "states": ["collapsed", "expanded"]
    },
    "hitlStagingCard": {
      "$description": "Human-in-the-loop staged decision card",
      "states": ["idle", "loading", "done", "rejected"]
    },
    "ruleOfThreeContainer": {
      "$description": "Ordered three-intervention triptych with priority indicators",
      "slots": 3
    }
  }
}
